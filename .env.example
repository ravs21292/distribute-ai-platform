# Copy to .env for local overrides. Never commit real secrets.
DML_ENV=dev

DML_DATABASE_URL=postgresql+asyncpg://dml:dml@localhost:5432/dml
DML_DATABASE_URL_SYNC=postgresql+psycopg://dml:dml@localhost:5432/dml
DML_REDIS_URL=redis://localhost:6379/0

DML_S3_ENDPOINT_URL=http://localhost:9000
DML_S3_ACCESS_KEY=dmlminio
DML_S3_SECRET_KEY=dmlminio
DML_S3_BUCKET=dml-artifacts
DML_S3_REGION=us-east-1

DML_API_HOST=0.0.0.0
DML_API_PORT=8000
DML_LOG_LEVEL=INFO
DML_LOG_JSON=true

# Auth / RBAC (optional). When set, send header X-API-Key.
# Leave empty for local demo (anonymous admin). For production set DML_AUTH_REQUIRED=true.
# DML_API_KEYS={"dml-admin-key":{"subject":"alice","role":"admin"},"dml-reader-key":{"subject":"bob","role":"reader"}}
# DML_AUTH_REQUIRED=true
DML_PII_REDACTION_ENABLED=true

DML_HEARTBEAT_INTERVAL_SECONDS=5
DML_WORKER_STALE_AFTER_SECONDS=15
DML_TASK_LEASE_SECONDS=30
DML_CLAIM_MIN_IDLE_MS=15000
DML_SCHEDULER_POLL_SECONDS=0.5
DML_SHUTDOWN_GRACE_SECONDS=20
DML_MAX_ATTEMPTS=5
